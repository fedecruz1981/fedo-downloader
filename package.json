{
  "name": "fedo-dwnloader",
  "version": "1.0.0",
  "description": "YTAudio Studio - YouTube Audio Downloader/Editor",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run compile:electron && cross-env NODE_ENV=development electron .",
    "compile:electron": "tsc electron/main.ts electron/preload.ts --outDir electron --module commonjs --target ES2020 --esModuleInterop --skipLibCheck --resolveJsonModule",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.294.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.fedo.ytaudiostudio",
    "productName": "YTAudio Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "sidecar/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "sign": false
    },
    "portable": {
      "useZip": false
    },
    "directories": {
      "buildResources": "assets"
    }
  }
}
