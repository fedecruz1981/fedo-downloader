{
  "name": "fedo-downloader",
  "version": "1.0.0",
  "description": "YTAudio Studio - YouTube Audio Downloader/Editor",
  "author": "federico-ariel-cruz",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run compile:electron && cross-env NODE_ENV=development electron .",
    "compile:electron": "tsc electron/main.ts electron/preload.ts --outDir electron --module commonjs --target ES2020 --esModuleInterop --skipLibCheck --resolveJsonModule",
    "build": "npm run build:renderer && npm run compile:electron && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.294.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.fedo.ytaudiostudio",
    "productName": "YTAudio Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "sidecar/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "useZip": false
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  }
}
